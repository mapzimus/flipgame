#!/usr/bin/env node
// HISTORICAL v1.11 SUITE — intentionally not an active executable test.
// Online was removed in v1.12 at d8bd7e0 (integrated e059af5). These tests
// require retired transport modules and document the former network contract.
// Active local coverage is preserved in scripts/v112-local-event-regression-tests.js.
// The original file and transports can be recovered together from Git history.

'use strict';

const assert = require('node:assert/strict');
const fs = require('node:fs');
const path = require('node:path');
const vm = require('node:vm');

const ROOT = path.resolve(__dirname, '..');
const Protocol = require('../js/v111-network-protocol.js');
const Net = require('../js/net.js');
const { game: gamePrototype } = require('../js/game.js');
const main = fs.readFileSync(path.join(ROOT, 'js/main.js'), 'utf8');
const css = fs.readFileSync(path.join(ROOT, 'css/style.css'), 'utf8');

const PLAYER_IDS = ['p_0000000000000001', 'p_0000000000000002'];
const DEFS = PLAYER_IDS.map((netId, index) => ({
  netId, name: `Player ${index + 1}`, color: index ? '#ef476f' : '#58c8ff', isAI: false,
}));
const PLINKO = ['double', 'halve', 'magnet', 'lose', 'win', 'lose', 'magnet', 'halve', 'double'];
const CANONICAL = {
  double: 'lives-doubled', halve: 'everyone-else-halved', magnet: 'always-magnet',
  lose: 'automatic-loss', win: 'automatic-win',
};

function loadPhysics() {
  const context = vm.createContext({ console, Math, window: { matchMedia: () => ({ matches: false }) } });
  for (const relative of [
    'js/vendor/matter.min.js', 'js/v111-interfaces.js', 'js/v111-physics-events.js', 'js/physics.js',
  ]) {
    let source = fs.readFileSync(path.join(ROOT, relative), 'utf8');
    if (relative === 'js/physics.js') source += '\nthis.__physics = Physics;';
    vm.runInContext(source, context, { filename: relative });
  }
  return context.__physics;
}

function physicalOutcome(eventId, index) {
  const physics = loadPhysics();
  physics.init(1280, 800);
  physics.forceSpecialEvent(eventId);
  physics.applyFlick(index % 2 ? 350 : -350, -2500, 7000 + index);
  for (let frame = 0; frame < 3600; frame++) {
    physics.step(1 / 60);
    const result = physics.checkLanding();
    if (!result) continue;
    const info = physics.getLastLandingInfo();
    const detail = physics.getEventResultMetadata() || {};
    const reward = detail.eventReward && typeof detail.eventReward === 'object' ? detail.eventReward : {};
    const meta = Object.assign({}, detail, {
      perfect: !!info.perfect,
      onCap: !!(info.onCap || info.reason === 'cap'),
      golden: eventId === 'golden-flip',
      plinko: detail.plinko || detail.prize || info.plinko || null,
      rareEvent: eventId,
      eventId,
      landedCount: detail.landedCount ?? reward.landedCount,
      rouletteMultiplier: detail.rouletteMultiplier || detail.multiplier || reward.multiplier,
      rouletteSlot: detail.rouletteSlot ?? reward.slotIndex,
      automaticOutcome: detail.automaticOutcome,
      eventReward: reward,
    });
    return { result, info, meta };
  }
  throw new Error(`${eventId} did not resolve`);
}

function newGame() {
  const value = Object.assign({}, gamePrototype, { callbacks: {} });
  value.init(DEFS, 1, { startingLives: 10 });
  return value;
}

function physicsBase() {
  return { onCap: false, pose: 'upright', contacts: 1, bounces: 0, banks: 0 };
}

function eventMeta(eventId, result = 'MAKE', options = {}) {
  const physics = physicsBase();
  const reward = {};
  let plinko = null;
  let automaticOutcome = null;
  if (eventId === 'rainbow-corkscrew') Object.assign(reward, { additiveLives: 1, capped: true });
  if (eventId === 'golden-flip') Object.assign(reward, { stakeMultiplier: 2 });
  if (eventId === 'shrink-ray') Object.assign(reward, { additiveLives: 2, capped: true });
  if (eventId === 'double-flip') Object.assign(reward, {
    flipperLivesMultiplier: 2, opponentsLivesMultiplier: 0.5,
    opponentRounding: 'max(1,ceil)', activeOpponentsOnly: true, bypassAdditiveCap: true,
  });
  if (eventId === 'heart-rush') Object.assign(reward, { additiveLives: 3, capped: true });
  if (eventId === 'life-drain') Object.assign(reward, { opponentsSetLives: 1, activeOpponentsOnly: true });
  if (eventId === 'mitosis') {
    const landedCount = options.landedCount == null ? 2 : options.landedCount;
    Object.assign(reward, { landedCount, additiveLives: landedCount === 2 ? 3 : 1, capped: true });
    physics.copies = [1, 2].map((copy) => ({ copy, made: copy <= landedCount,
      onCap: false, tilt: copy <= landedCount ? 0.04 : 1.4, reason: copy <= landedCount ? 'upright' : 'invalid-pose' }));
    physics.massConservationError = 0;
    physics.angularMomentumError = 0;
  }
  if (eventId === 'roulette-table') {
    const slotIndex = options.slotIndex == null ? 3 : options.slotIndex;
    const multiplier = [1, 2, 3, 4, 4, 3, 2, 1][slotIndex];
    Object.assign(reward, { slotIndex, multiplier, bypassAdditiveCap: true });
    physics.roulette = { wheelAngle: 1.25, slotIndex };
  }
  if (eventId === 'rewind') {
    const replayed = options.replayed === true || result === 'MISS';
    physics.rewind = { replayed, firstFailureReason: replayed ? 'fallen' : null,
      replaySucceeded: result === 'MAKE' };
  }
  if (eventId === 'cap-toss') {
    const made = result === 'MAKE';
    Object.assign(reward, made ? { additiveLives: 5, capped: true } : {});
    physics.capToss = { bodyLanded: made, capLanded: made, bothRequired: true };
  }
  if (eventId === 'meteor-shower') physics.meteorHits = 2;
  if (eventId === 'plinko') {
    const slotIndex = options.slotIndex;
    plinko = PLINKO[slotIndex];
    automaticOutcome = plinko === 'lose' ? 'MISS' : 'MAKE';
    Object.assign(reward, {
      slotIndex, legacyPrize: plinko, plinkoPrize: CANONICAL[plinko],
    });
    if (plinko === 'double') Object.assign(reward, { flipperLivesMultiplier: 2, bypassAdditiveCap: true });
    if (plinko === 'halve') Object.assign(reward, { opponentsLivesMultiplier: 0.5,
      opponentRounding: 'max(1,ceil)', activeOpponentsOnly: true, bypassAdditiveCap: true });
    if (plinko === 'magnet') reward.grantAlwaysMagnet = true;
    if (plinko === 'lose' || plinko === 'win') reward.automaticOutcome = automaticOutcome;
  }
  return {
    perfect: false,
    onCap: false,
    golden: eventId === 'golden-flip',
    plinko,
    automaticOutcome,
    eventReward: reward,
    meta: physics,
  };
}

function apply(game, resolution) {
  if (resolution.meta.plinko) game.resolvePlinko(resolution.meta.plinko);
  else game.resolveFlip(resolution.result, resolution.meta);
}

function gameState(game) {
  return JSON.parse(JSON.stringify({
    state: game.state, turnCounter: game.turnCounter, pointCount: game.pointCount,
    lastResult: game.lastResult, currentPlayerIndex: game.currentPlayerIndex,
    perfectLanding: game.perfectLanding, capLand: game.capLand, goldenFlip: game.goldenFlip,
    plinkoPrize: game.plinkoPrize, eventReward: game.eventReward,
    doubleFlipReward: game.doubleFlipReward, lifeDrainTriggered: game.lifeDrainTriggered,
    lifeDrainActive: game.lifeDrainActive,
    players: game.players,
  }));
}

function roundTrip(eventId, result = 'MAKE', options = {}) {
  const authorityMeta = eventMeta(eventId, result, options);
  const eventResult = Protocol.createEventResult({ eventId, result, meta: authorityMeta });
  const packet = { result, eventId, eventResult, info: { reason: result === 'MAKE' ? 'upright' : 'fallen' } };
  const parsed = Protocol.resolveAuthoritativeResult(JSON.parse(JSON.stringify(packet)), eventId);
  assert.equal(parsed.ok, true, `${eventId}: ${parsed.code}`);
  const authority = newGame();
  const observer = newGame();
  apply(authority, { result, meta: Protocol.resolveAuthoritativeResult(packet, eventId).value.meta });
  apply(observer, parsed.value);
  assert.deepEqual(gameState(observer), gameState(authority), `${eventId} authority/observer state`);
  return { packet, parsed: parsed.value };
}

function envelopeRoundTrip(eventId, result = 'MAKE', options = {}) {
  const host = new Protocol.ProtocolSession({ selfId: PLAYER_IDS[0], room: 'TEST', hostId: PLAYER_IDS[0],
    randomValues(array) { array.fill(1); } });
  const peer = new Protocol.ProtocolSession({ selfId: PLAYER_IDS[1], room: 'TEST', hostId: PLAYER_IDS[0] });
  const start = host.start({ defs: DEFS, startIndex: 0 });
  assert.equal(peer.receive(start, PLAYER_IDS[0]).ok, true);
  const flick = host.flick({ playerId: PLAYER_IDS[0], vx: 42, vy: -2400, seed: 99 });
  assert.equal(peer.receive(flick, PLAYER_IDS[0]).ok, true);
  const meta = eventMeta(eventId, result, options);
  const eventResult = Protocol.createEventResult({ eventId, result, meta });
  const envelope = host.result({ playerId: PLAYER_IDS[0], result, eventId, eventResult,
    info: { reason: result === 'MAKE' ? 'upright' : 'fallen' } });
  const received = peer.receive(JSON.parse(JSON.stringify(envelope)), PLAYER_IDS[0]);
  assert.equal(received.ok, true, `${eventId} NetworkEnvelopeV2: ${received.code}`);
  assert.equal(received.envelope.payload.eventResult.eventId, eventId);
}

assert.equal(Protocol.EVENT_IDS.length, 30);
for (const eventId of Protocol.EVENT_IDS) {
  if (eventId === 'plinko') {
    roundTrip(eventId, 'MAKE', { slotIndex: 4 });
    envelopeRoundTrip(eventId, 'MAKE', { slotIndex: 4 });
  } else {
    roundTrip(eventId);
    envelopeRoundTrip(eventId);
  }
}

// Capture the metadata produced by the real physics engine for every registry
// entry. This guards the strict wire projection against renderer/physics drift.
Protocol.EVENT_IDS.forEach((eventId, index) => {
  const physical = physicalOutcome(eventId, index);
  const wire = Protocol.createEventResult({ eventId, result: physical.result, meta: physical.meta });
  const resolved = Protocol.resolveAuthoritativeResult({ result: physical.result, eventId,
    eventResult: wire, info: physical.info }, eventId);
  assert.equal(resolved.ok, true, `${eventId} real physics metadata: ${resolved.code}`);
});

// Rewind's first failure is never a result packet. Only attempt two is final,
// and the observer consumes it directly rather than re-running local Rewind.
const rewind = roundTrip('rewind', 'MISS', { replayed: true });
assert.deepEqual(rewind.parsed.eventResult.attempt, { index: 2, replayed: true, final: true });
assert.equal(rewind.parsed.result, 'MISS');
const nonfinal = JSON.parse(JSON.stringify(rewind.packet));
nonfinal.eventResult.attempt = { index: 1, replayed: false, final: true };
nonfinal.eventResult.metadata.physics.rewind.replayed = false;
assert.equal(Protocol.resolveAuthoritativeResult(nonfinal, 'rewind').code, 'nonfinal-rewind-result');

// Every one of the nine physical slots remains distinguishable even though
// symmetrical slots share a prize.
PLINKO.forEach((prize, slotIndex) => {
  const result = prize === 'lose' ? 'MISS' : 'MAKE';
  const plinko = roundTrip('plinko', result, { slotIndex });
  assert.equal(plinko.parsed.eventResult.metadata.reward.slotIndex, slotIndex);
  assert.equal(plinko.parsed.meta.plinko, prize);
});

const mismatch = roundTrip('roulette-table').packet;
assert.equal(Protocol.resolveAuthoritativeResult(mismatch, 'mitosis').code, 'event-result-mismatch');
const missing = { result: 'MAKE', eventId: 'roulette-table', info: {} };
assert.equal(Protocol.resolveAuthoritativeResult(missing, 'roulette-table').code, 'missing-event-result');
assert.equal(Protocol.resolveAuthoritativeResult({ result: 'MAKE', info: {} }, null).ok, true,
  'ordinary legacy verdict remains safe');
const failClosedNet = Net.create({ root: { console, FlipgameV111NamePolicy: { validate: (value) => ({ valid: true, value }) } },
  protocol: Protocol, authenticateSender: ({ transportIdentity }) => transportIdentity });
assert.equal(failClosedNet.acceptResult(mismatch, 'mitosis'), null);
assert.equal(failClosedNet.compatible, false, 'event mismatch hides the online beta fail-closed');

// The live integration must validate before queueing and must not feed an
// authoritative event through Physics.forceLanding (the original Rewind crash).
assert.match(main, /Net\.acceptResult\(msg, canonicalEventId\(\)\)/);
assert.match(main, /const forced = authority\.eventResult \? authority\.result/);
assert.match(main, /resolveGameFlip\(forced,[\s\S]*authority\.meta\)/);

// Customize has three real rows. The conditional arena note overlays row 3,
// so no hidden fourth explicit track can consume the remaining gallery height.
assert.match(css, /\.customize-main\s*\{[^}]*grid-template-rows:\s*auto auto minmax\(0,1fr\)/s);
assert.match(css, /\.customize-main > \.seat-switcher\s*\{[^}]*grid-row:\s*1/s);
assert.match(css, /\.customize-main > \.tab-list\s*\{[^}]*grid-row:\s*2/s);
assert.match(css, /#arena-scope-note\s*\{[^}]*grid-row:\s*3/s);
assert.match(css, /#customize-panel\s*\{[^}]*grid-row:\s*3/s);
assert.doesNotMatch(css, /\.customize-main[^}]*auto auto auto minmax\(0,1fr\)/s);
const desktopPadding = 16;
const desktopMainHeight = 720 - 56 - 72;
const computedPanelHeight = desktopMainHeight - (2 * desktopPadding) - 48 - 48 - (2 * 10);
assert.equal(computedPanelHeight, 444, '1280x720 computed browser geometry stays stable');
assert.ok(computedPanelHeight > 400, '1280x720 active gallery is taller than 400px');
assert.ok(desktopPadding <= 16, 'gallery bottom stays near the main content bottom');

console.log('v1.11 final UI/network correction tests passed.');
