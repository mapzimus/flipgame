+    summary.textContent = `${list.length} characters · last unlock @ ${list[list.length - 1].unlock} wins`;
+    root.appendChild(summary);
+
+    for (const g of groups) {
+      const section = document.createElement('section');
+      section.className = 'group';
+      section.innerHTML = `<h2>${g} · ${seen.get(g).length}</h2>`;
+      const grid = document.createElement('div');
+      grid.className = 'grid';
+      for (const c of seen.get(g)) {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.dataset.id = c.id;
+        const cv = document.createElement('canvas');
+        cv.width = 96;
+        cv.height = 116;
+        const name = document.createElement('div');
+        name.className = 'name';
+        name.textContent = `${c.emoji || ''} ${c.name}`.trim();
+        const meta = document.createElement('div');
+        meta.className = 'meta';
+        const unlock = c.unlock == null ? 'free' : `${c.unlock} wins`;
+        meta.innerHTML = `<span class="swatch" style="background:${c.color || c.tint}"></span>${unlock}`;
+        card.appendChild(cv);
+        card.appendChild(name);
+        card.appendChild(meta);
+        grid.appendChild(card);
+        requestAnimationFrame(() => {
+          try {
+            const tint = c.tint || c.color || '#1f9bff';
+            Renderer.drawPreview(cv, c.drawAs === 'bottle' ? 'bottle' : c.id, tint);
+          } catch (e) {
+            const ctx = cv.getContext('2d');
+            ctx.fillStyle = '#ff5252';
+            ctx.font = '12px monospace';
+            ctx.fillText('err', 8, 20);
+          }
+        });
+      }
+      section.appendChild(grid);
+      root.appendChild(section);
+    }
+
+    // Second pass after PNG sprites decode
+    if (Skins.onSpriteLoad) {
+      Skins.onSpriteLoad(() => {
+        document.querySelectorAll('.card').forEach((card, i) => {
+          const c = list[i];
+          // rebuild map by walking DOM order instead
+        });
+        // simpler: redraw all cards from list order
+        const canvases = [...document.querySelectorAll('.card canvas')];
+        list.forEach((c, i) => {
+          const cv = canvases[i];
+          if (!cv) return;
+          const tint = c.tint || c.color || '#1f9bff';
+          try {
+            Renderer.drawPreview(cv, c.drawAs === 'bottle' ? 'bottle' : c.id, tint);
+          } catch (_) {}
+        });
+      });
+    }
+    // Warm PNG caches
+    if (Skins.preload) {
+      const tints = [...new Set(list.map((c) => c.tint || c.color).filter(Boolean))];
+      Skins.preload(tints);
+    }
+  </script>
+</body>
+</html>
